PORT=5000
GROQ_API_KEY=
# Comma-separated public web origins allowed to access this API.
CORS_ORIGIN=http://localhost:5173
# Required only to update lifecycle state through PATCH /api/complaints/:id/status
ADMIN_API_KEY=
# Demo municipality official account. The username may be changed, but do not
# commit OFFICIAL_PASSWORD or OFFICIAL_SESSION_SECRET values.
OFFICIAL_USERNAME=admin@civicroute.gov.in
OFFICIAL_PASSWORD=
# Use a long, random value locally (for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
OFFICIAL_SESSION_SECRET=
# Optional SMTP confirmation email. Leave blank to test the safe non-delivery path.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional: keep persistent data outside the deployed code directory.
# CIVICROUTE_DATA_PATH=/var/lib/civicroute/data.json
